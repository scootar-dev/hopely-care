            "minimum": 0.0,
            "title": "Confidence"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "primary_emotion",
          "scores",
          "themes",
          "confidence",
          "metadata"
        ],
        "title": "EmotionResponse"
      },
      "EmotionScores": {
        "properties": {
          "fear": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fear"
          },
          "sadness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Sadness"
          },
          "anxiety": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Anxiety"
          },
          "loneliness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Loneliness"
          },
          "anger": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Anger"
          },
          "hope": {
            "type": "number",
            "maximum": 1.0,
