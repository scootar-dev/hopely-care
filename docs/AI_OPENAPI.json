      "IngestRequest": {
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Publisher"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "document_version": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Document Version"
          },
          "reviewed_by": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reviewed By"
          },
          "reviewed": {
            "type": "boolean",
            "const": true,
            "title": "Reviewed"
          },
          "text": {
            "type": "string",
            "maxLength": 200000,
            "minLength": 20,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "title",
          "publisher",
          "document_version",
          "reviewed_by",
          "reviewed",
          "text"
        ],
        "title": "IngestRequest"
      },
